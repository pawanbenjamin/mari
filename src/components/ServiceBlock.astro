---
import CldImage from "./CldImage.astro";

export interface Props {
  title: string;
  desc: string;
  treatmentList: string[];
  imageUrl: string;
  number?: string;
}

const { title, desc, treatmentList, imageUrl, number } = Astro.props;
const listLabel =
  title === "community education classes"
    ? "class topics include"
    : "common conditions treated";
---

<article
  class="service-block border-b border-sage-100 py-10 first:pt-0 last:border-b-0"
>
  <div class="md:flex md:gap-6 lg:gap-8 md:items-center">
    {
      imageUrl !== "" && (
        <figure class="mb-6 md:mb-0 md:w-56 lg:w-64 md:shrink-0 md:self-start aspect-[4/3] overflow-hidden rounded-md bg-sage-50 shadow-sm shadow-sage-900/5">
          <CldImage
            src={imageUrl}
            alt={title}
            height="auto"
            width="auto"
            class="h-full w-full object-cover saturate-[.85] contrast-[1.05]"
          />
        </figure>
      )
    }

    <div class="md:flex-1 md:min-w-0">
      <h3 class="flex items-baseline gap-4 text-ink">
        {
          number && (
            <span class="font-sans text-xs tracking-widest text-sage-500 shrink-0 tabular-nums">
              {number}
            </span>
          )
        }
        <span
          class="font-display text-2xl md:text-3xl font-light tracking-tightish"
        >
          {title}
        </span>
      </h3>

      <p class="mt-4 text-ink-soft leading-relaxed">{desc}</p>
    </div>
  </div>

  {
    treatmentList && treatmentList.length > 0 && (
      <details
        class:list={[
          "expandable mt-6 pl-4 border-l-2 border-sage-200",
          imageUrl !== "" && "md:ml-[15.5rem] lg:ml-[18rem]"
        ]}
      >
        <summary class="cursor-pointer list-none font-sans text-xs uppercase tracking-widest text-sage-600 hover:text-sage-700 inline-flex items-center gap-1">
          <span class="expandable-label">{listLabel}</span>
          <span class="expandable-arrow transition-transform duration-300">
            &rarr;
          </span>
        </summary>
        <ul class="expandable-content mt-3 grid gap-1.5 text-sm text-ink-soft sm:grid-cols-2 overflow-hidden">
          {treatmentList.map((treatment) => (
            <li class="flex gap-2">
              <span class="text-sage-400" aria-hidden="true">
                ·
              </span>
              <span>{treatment}</span>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</article>

<style>
  details.expandable[open] .expandable-arrow {
    transform: rotate(90deg);
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const easing = "cubic-bezier(0.4, 0, 0.2, 1)";
  const heightDuration = prefersReducedMotion ? 0 : 320;
  const itemDuration = prefersReducedMotion ? 0 : 400;
  const itemStaggerStart = prefersReducedMotion ? 0 : 120;
  const itemStaggerStep = prefersReducedMotion ? 0 : 60;
  const itemStaggerCap = 8;

  document
    .querySelectorAll<HTMLDetailsElement>("details.expandable")
    .forEach((details) => {
      const summary = details.querySelector("summary");
      const content = details.querySelector<HTMLElement>(
        ".expandable-content"
      );
      if (!summary || !content) return;

      let heightAnim: Animation | null = null;
      let itemAnims: Animation[] = [];

      const cancelAll = () => {
        if (heightAnim) heightAnim.cancel();
        itemAnims.forEach((a) => a.cancel());
        itemAnims = [];
      };

      const animateItemsIn = () => {
        const items = content.querySelectorAll<HTMLElement>("li");
        items.forEach((item, i) => {
          const delay =
            itemStaggerStart + Math.min(i, itemStaggerCap) * itemStaggerStep;
          const anim = item.animate(
            [
              { opacity: 0, transform: "translateY(8px)" },
              { opacity: 1, transform: "translateY(0)" }
            ],
            { duration: itemDuration, easing, delay, fill: "both" }
          );
          anim.onfinish = () => {
            item.style.opacity = "";
            item.style.transform = "";
          };
          itemAnims.push(anim);
        });
      };

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        cancelAll();

        if (details.open) {
          const startHeight = content.offsetHeight;
          heightAnim = content.animate(
            [
              { height: startHeight + "px", opacity: 1 },
              { height: "0px", opacity: 0 }
            ],
            { duration: heightDuration, easing }
          );
          heightAnim.onfinish = () => {
            details.open = false;
            content.style.height = "";
            content.style.opacity = "";
            heightAnim = null;
          };
        } else {
          details.open = true;
          const endHeight = content.offsetHeight;
          heightAnim = content.animate(
            [
              { height: "0px", opacity: 0 },
              { height: endHeight + "px", opacity: 1 }
            ],
            { duration: heightDuration, easing }
          );
          heightAnim.onfinish = () => {
            content.style.height = "";
            content.style.opacity = "";
            heightAnim = null;
          };
          animateItemsIn();
        }
      });
    });
</script>
