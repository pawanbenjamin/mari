---
import CldImage from "./CldImage.astro";

export interface Props {
  title: string;
  desc: string;
  treatmentList: string[];
  imageUrl: string;
  number?: string;
}

const { title, desc, treatmentList, imageUrl, number } = Astro.props;
const listLabel =
  title === "community education classes"
    ? "class topics include"
    : "common conditions treated";
---

<article
  class="service-block border-b border-sage-100 py-10 first:pt-0 last:border-b-0"
>
  {
    imageUrl !== "" && (
      <figure class="mb-6 overflow-hidden rounded-md bg-sage-50 aspect-[4/3] shadow-sm shadow-sage-900/5">
        <CldImage
          src={imageUrl}
          alt={title}
          height="auto"
          width="auto"
          class="h-full w-full object-cover saturate-[.85] contrast-[1.05]"
        />
      </figure>
    )
  }

  <details class="group">
    <summary
      class="flex items-baseline justify-between gap-4 cursor-pointer list-none text-ink hover:text-sage-600 transition-colors"
    >
      <span class="flex items-baseline gap-4 min-w-0">
        {
          number && (
            <span class="font-sans text-xs tracking-widest text-sage-500 shrink-0 tabular-nums">
              {number}
            </span>
          )
        }
        <span
          class="font-display text-2xl md:text-3xl font-light tracking-tightish"
        >
          {title}
        </span>
      </span>
      <span
        class="shrink-0 text-sage-500 text-xl transition-transform group-open:rotate-45"
        aria-hidden="true">+</span
      >
    </summary>

    <div class="mt-5 space-y-5">
      <p class="text-ink-soft leading-relaxed">{desc}</p>

      {
        treatmentList && treatmentList.length > 0 && (
          <details class="pl-4 border-l-2 border-sage-200">
            <summary class="cursor-pointer list-none font-sans text-xs uppercase tracking-widest text-sage-600 hover:text-sage-700">
              {listLabel} &rarr;
            </summary>
            <ul class="mt-3 grid gap-1.5 text-sm text-ink-soft sm:grid-cols-2">
              {treatmentList.map((treatment) => (
                <li class="flex gap-2">
                  <span class="text-sage-400" aria-hidden="true">
                    ·
                  </span>
                  <span>{treatment}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </details>
</article>
