---
const links = [
  { href: "/", label: "home" },
  { href: "/about", label: "about" },
  { href: "/services", label: "services" },
  { href: "/treatments", label: "treatments" },
  { href: "/faq", label: "faq" },
  { href: "/contact", label: "contact" }
];
---

<header
  class="sticky top-0 z-30 backdrop-blur-sm bg-cream-100/80 border-b border-sage-100"
>
  <div
    class="mx-auto max-w-page px-6 py-4 flex items-center justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-3 font-display text-lg md:text-xl tracking-tightish font-normal"
    >
      <img
        src="/logo.svg"
        alt="Mariposa Wellness"
        class="h-8 md:h-9 w-auto shrink-0"
      />
      <span class="flex items-baseline gap-1.5">
        <span class="text-sage-600">mariposa</span>
        <span class="text-ink-soft italic font-light">wellness</span>
      </span>
    </a>

    <div class="flex items-center gap-6">
      <a
        href="/contact"
        class="hidden sm:inline-flex text-xs font-sans uppercase tracking-widest text-ink-soft hover:text-sage-600"
      >
        contact
      </a>
      <button
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="overlay-menu"
        class="hamburger relative w-8 h-8 flex items-center justify-center text-ink"
      >
        <span class="hamburger-line hamburger-line--top" aria-hidden="true"
        ></span>
        <span class="hamburger-line hamburger-line--mid" aria-hidden="true"
        ></span>
        <span class="hamburger-line hamburger-line--bot" aria-hidden="true"
        ></span>
      </button>
    </div>
  </div>
</header>

<nav
  id="overlay-menu"
  class="overlay-menu fixed inset-0 z-50 bg-cream-100 pointer-events-none opacity-0 transition-opacity duration-300 overflow-y-auto"
  aria-hidden="true"
>
  <div class="min-h-full flex flex-col">
    <div
      class="flex items-center justify-between px-6 py-4 border-b border-sage-100"
    >
      <a
        href="/"
        class="flex items-center gap-3 font-display text-lg md:text-xl tracking-tightish font-normal"
      >
        <img
          src="/logo.svg"
          alt="Mariposa Wellness"
          class="h-8 md:h-9 w-auto shrink-0"
        />
        <span class="flex items-baseline gap-1.5">
          <span class="text-sage-600">mariposa</span>
          <span class="text-ink-soft italic font-light">wellness</span>
        </span>
      </a>
      <button
        id="menu-close"
        aria-label="Close menu"
        class="close-btn w-8 h-8 flex items-center justify-center text-ink hover:text-sage-600 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>

    <ul
      class="menu-list flex-1 flex flex-col items-center justify-center gap-4 sm:gap-6 py-12 px-6 text-center"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-display text-2xl sm:text-3xl md:text-4xl font-light tracking-tightish hover:text-sage-600 transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="px-6 py-6 text-center">
      <a
        href="mailto:admin@mariposawellnessllc.com"
        class="text-xs font-sans uppercase tracking-widest text-ink-muted hover:text-sage-600"
      >
        admin@mariposawellnessllc.com
      </a>
    </div>
  </div>
</nav>

<style>
  /* Hamburger — three centered bars that morph into an X */
  .hamburger {
    cursor: pointer;
  }
  .hamburger-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    border-radius: 2px;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease-out,
      background-color 0.2s ease;
  }
  .hamburger-line--top {
    transform: translate(-50%, calc(-50% - 7px));
  }
  .hamburger-line--mid {
    transform: translate(-50%, -50%);
  }
  .hamburger-line--bot {
    transform: translate(-50%, calc(-50% + 7px));
  }
  .hamburger.open .hamburger-line--top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .hamburger.open .hamburger-line--mid {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0);
  }
  .hamburger.open .hamburger-line--bot {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Overlay + close-X entrance */
  .overlay-menu.open {
    opacity: 1;
    pointer-events: auto;
  }
  .close-btn {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
    transition:
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.15s,
      opacity 0.3s ease-out 0.15s,
      color 0.2s ease;
  }
  .overlay-menu.open .close-btn {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* Menu items — gentle staggered fade-up */
  .menu-list li {
    opacity: 0;
    transform: translateY(8px);
    transition:
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s ease-out;
  }
  .overlay-menu.open .menu-list li {
    opacity: 1;
    transform: translateY(0);
  }
  .overlay-menu.open .menu-list li:nth-child(1) {
    transition-delay: 0.12s;
  }
  .overlay-menu.open .menu-list li:nth-child(2) {
    transition-delay: 0.18s;
  }
  .overlay-menu.open .menu-list li:nth-child(3) {
    transition-delay: 0.24s;
  }
  .overlay-menu.open .menu-list li:nth-child(4) {
    transition-delay: 0.3s;
  }
  .overlay-menu.open .menu-list li:nth-child(5) {
    transition-delay: 0.36s;
  }
  .overlay-menu.open .menu-list li:nth-child(6) {
    transition-delay: 0.42s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line,
    .close-btn,
    .menu-list li {
      transition-duration: 0.01s;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("overlay-menu");

  const openMenu = () => {
    toggle?.classList.add("open");
    menu?.classList.add("open");
    menu?.setAttribute("aria-hidden", "false");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const closeMenu = () => {
    toggle?.classList.remove("open");
    menu?.classList.remove("open");
    menu?.setAttribute("aria-hidden", "true");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.classList.contains("open")) closeMenu();
  });
</script>
