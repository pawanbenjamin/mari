---
export interface Props {
  title: string;
  desc: string;
  prev: string;
  next: string;
}

const { title, desc, prev, next } = Astro.props;
const prevHref = prev === "home" ? "/" : `/${prev}`;
const nextHref = next === "home" ? "/" : `/${next}`;
---

<section id="sub-nav" class="mx-auto max-w-page px-6 pt-10 md:pt-16">
  <div class="flex flex-col gap-4">
    {
      (title || desc) && (
        <h1 class="font-display font-light tracking-tightish text-4xl md:text-6xl leading-[1.05]">
          {title && <span class="block text-ink">{title}</span>}
          {desc && <span class="block italic text-sage-600">{desc}</span>}
        </h1>
      )
    }
    <nav
      class="mt-4 flex items-center justify-between text-xs font-sans uppercase tracking-widest text-ink-muted"
    >
      <a href={prevHref} class="hover:text-sage-600">
        &larr; {prev}
      </a>
      <a href={nextHref} class="hover:text-sage-600">
        {next} &rarr;
      </a>
    </nav>
    <hr class="mt-2 border-sage-100" />
  </div>
</section>
